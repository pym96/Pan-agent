{
  "name": "pan-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "agent": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "conformance": "node --experimental-strip-types --test test/conformance.test.ts test/kernel-conformance.test.ts test/cutover-contract.test.ts",
    "kernel-conformance": "node --experimental-strip-types --test test/kernel-conformance.test.ts",
    "pan-contracts": "node --experimental-strip-types --test test/pan-contracts.test.ts",
    "pan-faux-tools": "node --experimental-strip-types --test test/pan-faux-tools.test.ts",
    "pan-deepseek": "node --experimental-strip-types --test test/pan-deepseek-adapter.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/",
    "bin/",
    "RUNBOOK.md",
    "README.md"
  ],
  "bin": {
    "pan-agent": "bin/pan-agent.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./faux": {
      "types": "./dist/faux-model-adapter.d.ts",
      "import": "./dist/faux-model-adapter.js"
    }
  },
  "types": "./dist/index.d.ts"
}
