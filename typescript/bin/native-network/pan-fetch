#!/bin/sh
# Stock curl reads only from the task's Unix GET gateway.
if [ "$#" -ne 1 ] || [ -z "${PAN_NETWORK_SOCKET:-}" ]; then
  echo 'usage inside the native network sandbox: pan-fetch URL' >&2
  exit 2
fi
exec /usr/bin/curl -q --fail --silent --show-error --noproxy '*' \
  --unix-socket "$PAN_NETWORK_SOCKET" --get --data-urlencode "url=$1" \
  http://localhost/fetch
