{
  "name": "pan-overnight-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
